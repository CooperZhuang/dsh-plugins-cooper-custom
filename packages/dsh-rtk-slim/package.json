{
  "name": "dsh-rtk-slim",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH host plugin: condense oversized bash/job_output text through rtk, with lossless spill traceability",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.1-rc.2 || ^0.2.2-alpha.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "rtk",
    "token-reduction",
    "output-compaction",
    "bash",
    "spill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CooperZhuang/dsh-plugins-cooper-custom.git",
    "directory": "packages/dsh-rtk-slim"
  },
  "homepage": "https://github.com/CooperZhuang/dsh-plugins-cooper-custom/tree/main/packages/dsh-rtk-slim#readme",
  "bugs": {
    "url": "https://github.com/CooperZhuang/dsh-plugins-cooper-custom/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg"
}
