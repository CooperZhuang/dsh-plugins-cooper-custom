{
  "name": "dsh-folder-path",
  "version": "0.1.0",
  "description": "DSH 插件：粘贴（复制来的）文件夹时不再尝试上传，而是把它的完整路径作为文本插入输入框（Windows / macOS）。Paste a copied folder and get its full path as text instead of a failed upload (Windows and macOS).",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepare": "node scripts/build-client.mjs",
    "test": "node --check lib/index.js && node --check lib/client.js && node --test"
  },
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.1-rc.2 || ^0.2.2-alpha.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "client-plugin",
    "cordis-plugin",
    "paste",
    "folder",
    "path",
    "clipboard",
    "macos",
    "windows"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CooperZhuang/dsh-plugins-cooper-custom.git",
    "directory": "packages/dsh-folder-path"
  },
  "homepage": "https://github.com/CooperZhuang/dsh-plugins-cooper-custom/tree/main/packages/dsh-folder-path#readme",
  "bugs": {
    "url": "https://github.com/CooperZhuang/dsh-plugins-cooper-custom/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
