{
  "name": "dsh-open-in-dsh",
  "version": "0.2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "在 Windows 资源管理器 / macOS Finder 里右键文件夹 →「通过 DSH 打开」：DSH 把该目录作为工作区切入，并复用或新建一个空白会话。Explorer / Finder context-menu entry that opens a folder as a DSH workspace with a blank session.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.json && node scripts/build-client.mjs && node --check lib/index.js && node --check lib/client.js && node --check client/index.js && node --test test/host.test.mjs test/routes.test.mjs test/scripts.test.mjs test/macos.test.mjs test/open-with.test.mjs test/session.test.mjs test/menu.test.mjs test/session-menu.test.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.1-rc.2 || ^0.2.2-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "dsh-session-ops": ">=0.1.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "explorer",
    "context-menu",
    "finder",
    "quick-action",
    "workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CooperZhuang/dsh-plugins-cooper-custom.git",
    "directory": "packages/dsh-open-in-dsh"
  },
  "homepage": "https://github.com/CooperZhuang/dsh-plugins-cooper-custom/tree/main/packages/dsh-open-in-dsh#readme",
  "bugs": {
    "url": "https://github.com/CooperZhuang/dsh-plugins-cooper-custom/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
