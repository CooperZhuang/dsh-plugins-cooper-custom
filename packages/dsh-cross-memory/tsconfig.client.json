{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "client",
    "outDir": ".client-build",
    "strict": false,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["client/**/*.ts", "client/**/*.d.ts"]
}
